# Copy this file to .env.local and fill in what you need. All values are optional.

# Your live domain (used for sitemap, canonical links and share images).
NEXT_PUBLIC_SITE_URL=https://shoesgpt.in

# From Google Search Console > Settings > Ownership verification > HTML tag (just the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# From Bing Webmaster Tools > Add site > HTML Meta Tag (just the content="..." value).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
